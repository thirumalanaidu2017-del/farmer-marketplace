<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <EditText
        android:id="@+id/productNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Product name, e.g. Rice" />

    <EditText
        android:id="@+id/priceInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Price per unit"
        android:inputType="numberDecimal"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/unitInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Unit (e.g. kg, dozen) - defaults to kg"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/quantityInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantity available"
        android:inputType="number"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/notesInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quality notes (optional)"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/saveListingButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Listing"
        android:layout_marginTop="24dp" />

</LinearLayout>
